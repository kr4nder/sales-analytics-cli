<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Доменный слой: модели, абстракции и реализации сервисов -->
    <RootNamespace>SalesAnalytics.Core</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Только абстракции DI: слой не зависит от конкретного контейнера -->
